# ---------------------------------------------------------------------------
# Copy to .env and edit.  Every value has a working default in server/config.js,
# so an empty file is fine for local development.
# ---------------------------------------------------------------------------

NODE_ENV=development

# Express: serves dist/ and /api/geo
PORT=3000

# Socket.IO: separate process + port (server/socket/index.js)
SOCKET_PORT=4001
# Comma-separated origins, or * for development.
SOCKET_CORS_ORIGIN=*

# Password for the /admin namespace.  REQUIRED in production; change it.
ADMIN_PASSWORD=change-me-admin

# Where `npm run build` writes the React app.
DIST_DIR=dist

# ---------------------------------------------------------------------------
# Geo lookup (/api/geo)
# ---------------------------------------------------------------------------
# Rotating outbound proxies, comma-separated.  Both HTTP and HTTPS proxies work:
#   GEO_PROXIES=http://user:pass@proxy1:8080,http://user:pass@proxy2:8080
GEO_PROXIES=

# If all proxies fail, ask the provider directly (free APIs rate-limit by IP).
GEO_ALLOW_DIRECT=true

# Trust Cloudflare / Vercel country headers and skip the provider call.
GEO_TRUST_COUNTRY_HEADER=true

GEO_TIMEOUT_MS=4500
GEO_CACHE_TTL_MS=43200000
GEO_NEGATIVE_CACHE_TTL_MS=60000
GEO_MAX_ATTEMPTS=3

# ---------------------------------------------------------------------------
# Telegram bot (grammY) — optional
# ---------------------------------------------------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Chat that receives "new submission" notifications.
TELEGRAM_CHAT_ID=
# Optional comma-separated Telegram user ids allowed to use the bot.
TELEGRAM_ALLOWED_USERS=

# ---------------------------------------------------------------------------
# Store
# ---------------------------------------------------------------------------
STORE_FILE=server/data/items.json
STORE_SEED=true

# The React app needs the Socket.IO address at build time.  Leave empty to use
# http://<current-host>:4001, or set it when the socket server is elsewhere.
# VITE_SOCKET_URL=https://socket.example.com
